{
  "manifest_version": 3,
  "name": "MCBG Data Export",
  "version": "0.2.3",
  "description": "MaxCompute 表数据一键导出为 xlsx / csv，支持百万级。",
  "action": {
    "default_title": "MaxCompute Data Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": ["storage", "downloads", "sidePanel"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
